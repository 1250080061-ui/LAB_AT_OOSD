<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<!-- false: chưa kết nối SQL -->
		<add key="UseSql" value="false"/>
	</appSettings>

	<connectionStrings>
		<add name="EShoppingDb"
			 connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=EShoppingLab4;Integrated Security=True;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient"/>
	</connectionStrings>

	<startup useLegacyV2RuntimeActivationPolicy="true">
		<supportedRuntime
			version="v4.0"
			sku=".NETFramework,Version=v4.7.2"/>
	</startup>
</configuration>